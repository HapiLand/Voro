.inspector {
    background-color: rgb(244, 17, 29);
    width: 30%;
}

.root {
    flex-grow: 1;
    flex-direction: row;
}

.canvas {
    flex-grow: 1;
    flex-direction: column;
}

.main {
    flex-grow: 1;
    flex-direction: column;
    flex-shrink: 1;
}

.world {
    background-color: rgb(255, 154, 53);
    flex-grow: 0;
    height: 10%;
    transition: height 0.3s ease;
}

.world-hover {
    height: 50%;
}

.toolbar {
    flex-shrink: 1;
    flex-direction: column;
}

.column-container {
    background-color: rgb(255, 222, 83);
    flex-direction: row-reverse;
    flex-grow: 1;
    justify-content: space-evenly;
    align-items: stretch;
}

.column {
    background-color: rgb(64, 102, 255);
    flex-grow: 0;
    width: auto;
    height: auto;
    align-items: center;
    justify-content: flex-start;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    max-height: none;
}

.selected-column {
    background-color: rgb(143, 255, 167);
    flex-grow: 0;
    width: auto;
    height: auto;
    align-items: center;
    justify-content: flex-start;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    max-height: none;
}

.column-top-row {
    flex-direction: row;
    background-color: rgb(0, 0, 0);
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.column-button {
}

.node {
    background-color: rgb(117, 117, 117);
    flex-grow: 0;
    align-items: flex-start;
    width: auto;
    margin-top: 10px;
    margin-right: 5px;
    margin-bottom: 10px;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.selected-node {
    border: 2px solid cyan;
    background-color: rgb(51, 51, 51);
}

.node-toggle {
}

.node-button {
}

.node-row {
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-right: 10px;
    margin-left: 10px;
}

.node-label {
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
}

.label {
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
}

.scroll {
    flex-grow: 0;
    width: auto;
    justify-content: space-evenly;
    align-content: stretch;
}
