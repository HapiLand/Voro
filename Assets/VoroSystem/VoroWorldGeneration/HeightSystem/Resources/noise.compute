#pragma kernel CSMain

RWStructuredBuffer<float> Result;
StructuredBuffer<float> InputX;
StructuredBuffer<float> InputZ;

float Size;
float Roughness;

float hash(float2 p)
{
    p = frac(p * 0.3183099 + 0.1);
    p *= 17.0;
    return frac(p.x * p.y * (p.x + p.y));
}

float valueNoise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);

    float a = hash(i);
    float b = hash(i + float2(1, 0));
    float c = hash(i + float2(0, 1));
    float d = hash(i + float2(1, 1));

    float2 u = f * f * (3.0 - 2.0 * f);

    return lerp(
        lerp(a, b, u.x),
        lerp(c, d, u.x),
        u.y
    );
}

float fbm(float2 p, int octaves, float roughness)
{
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;

    for (int i = 0; i < octaves; i++)
    {
        value += valueNoise(p * frequency) * amplitude;
        frequency *= 2.0;
        amplitude *= roughness;
    }

    return value;
}

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    float x = InputX[index];
    float z = InputZ[index];

    float scale = Size;
    float2 p = float2(x, z) / max(scale, 0.0001);
    float r = saturate(Roughness);
    int octaves = lerp(1, 6, r);
    float height = fbm(p, octaves, lerp(0.3, 0.7, r));

    Result[index] = height;
}
