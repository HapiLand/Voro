            <ui:VisualElement style="flex-grow: 0; align-items: flex-end;">
                <ui:Instance template="Toggle" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="--Description--" name="Description" class="bodyText" />
    </ui:VisualElement>
</ui:UXML>
