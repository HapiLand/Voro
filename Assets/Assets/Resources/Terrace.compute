#pragma kernel Effect

struct vertex
{
    float2 position;
    float height;
};

RWStructuredBuffer<vertex> vertex_buffer;
uint vertex_count;

cbuffer fx_params
{
    float stepsize;
    float randomness;
    int operation; // Set, Subtract, Add, Multiply
}

float Solve(float2 p)
{
    float direction = 0.0;
    float rad = radians(direction);
    float2 d = float2(cos(rad), sin(rad));
    float result = dot(p, d);

    float div = result / stepsize;
    float flat = floor(div);
    uint seed = 0;
    // Random.InitState(Mathf.RoundToInt(flat) + seed);
