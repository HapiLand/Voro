    // val = remap(val, Data.minStepSize, Data.maxStepSize) * Data.iterations;
    float min_step = 0.0;
    float max_step = 1.0;
    uint iterations = 1;
    val = (val * (max_step - min_step) + min_step) * iterations;

    // find the final value of the terrace
    float level = (flat + val) * stepsize;

    // level /= 2.0;
    return level;
